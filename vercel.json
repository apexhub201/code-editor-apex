{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "installCommand": "npm install",
  "functions": {
    "api/load.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/raw.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/obfuscate.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/create.js": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/auth.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/get-script.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/verify.js": {
      "memory": 256,
      "maxDuration": 5
    },
    "api/ping.js": {
      "memory": 256,
      "maxDuration": 5
    },
    "api/challenge.js": {
      "memory": 256,
      "maxDuration": 5
    },
    "api/validate.js": {
      "memory": 256,
      "maxDuration": 5
    },
    "api/update.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/delete.js": {
      "memory": 256,
      "maxDuration": 5
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/load", "destination": "/api/load" },
    { "source": "/auth", "destination": "/api/auth" },
    { "source": "/get-script", "destination": "/api/get-script" },
    { "source": "/raw", "destination": "/api/raw" },
    { "source": "/verify", "destination": "/api/verify" },
    { "source": "/ping", "destination": "/api/ping" },
    { "source": "/challenge", "destination": "/api/challenge" },
    { "source": "/validate", "destination": "/api/validate" },
    { "source": "/obfuscate", "destination": "/api/obfuscate" },
    { "source": "/create", "destination": "/api/create" },
    { "source": "/update", "destination": "/api/update" },
    { "source": "/delete", "destination": "/api/delete" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/google8c9c72c3ee73c2d1.html", "destination": "/google8c9c72c3ee73c2d1.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-Session-Token, X-Challenge-Token, X-Challenge-Answer, X-Auth-Key" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
