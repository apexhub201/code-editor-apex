{
  "version": 2,
  "buildCommand": "echo 'APEX HUB V10 Build'",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/raw", "destination": "/api/raw.js" },
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/challenge", "destination": "/api/challenge.js" },
    { "source": "/api/get-script", "destination": "/api/get-script.js" },
    { "source": "/api/load", "destination": "/api/load.js" },
    { "source": "/api/ping", "destination": "/api/ping.js" },
    { "source": "/api/verify", "destination": "/api/verify.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
